rules_version = '2';

// 青山 PEAK TEA — 揪團點餐 Firestore 規則
// 只開放 orders 這個 collection，其餘一律拒絕；沒有登入系統，
// 所以用欄位型別/長度做基本檢查，取代身分驗證。
service cloud.firestore {
  match /databases/{database}/documents {

    match /orders/{orderId} {
      allow read: if true;

      allow create: if request.resource.data.keys().hasAll([
                        'person', 'productId', 'name', 'category',
                        'size', 'sizeLabel', 'sweet', 'ice', 'addons',
                        'qty', 'unitPrice', 'createdAt'
                      ])
                    && request.resource.data.person is string
                    && request.resource.data.person.size() > 0
                    && request.resource.data.person.size() <= 20
                    && request.resource.data.qty is int
                    && request.resource.data.qty > 0
                    && request.resource.data.qty <= 20
                    && request.resource.data.unitPrice is number
                    && request.resource.data.unitPrice >= 0
                    && request.resource.data.unitPrice <= 2000
                    && request.resource.data.addons is list;

      allow update: if false; // 前端只會新增或刪除，不會局部更新
      allow delete: if true;
    }

    // 其餘所有 collection 一律拒絕存取
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
